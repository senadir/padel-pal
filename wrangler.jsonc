{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "padel-pal",
    "compatibility_date": "2025-09-02",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "@tanstack/react-start/server-entry",
    "placement": {
        "mode": "smart"
    },
    "r2_buckets": [
        {
            "binding": "OG_IMAGES",
            "bucket_name": "padel-pal-og-images"
        }
    ],
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1
        }
    }
}